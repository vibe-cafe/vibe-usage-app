# Node.js bundled at "Vibe Usage.app/Contents/Helpers/node" (approved
# 2026-11-14, 《Mac 自带 Node 方案》). scripts/fetch-node.sh downloads the
# official nodejs.org tar.xz for each architecture and accepts it only when its
# SHA256 matches both the published SHASUMS256.txt and the value pinned here.
# Before each Mac release, move to the newest 24.x patch: update all three
# lines from https://nodejs.org/dist/v<version>/SHASUMS256.txt (see
# docs/RELEASING.md "Bundled Node").
NODE_VERSION=24.22.3
NODE_SHA256_DARWIN_ARM64=1d64136c8a43d648d1b3bad10797a4c995b1ca032d2bde8799de43b37f058fe5
NODE_SHA256_DARWIN_X64=4daeec962855c1a6e66cda398a25037319dc1bbd4a0939188b3547afbbfb6490
